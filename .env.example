# ---- Game server (apps/server) — never expose to the browser ----
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/redline?sslmode=require
SESSION_SECRET=change-me-64-random-bytes
HOST_ADMIN_KEY=change-me
PORT=2567
PUBLIC_WEB_ORIGIN=http://localhost:5173
EVENT_SEED=20261119

# ---- Web client (apps/web, Vercel) — public values only ----
VITE_SERVER_URL=http://localhost:2567
VITE_WS_URL=ws://localhost:2567

# ---- Optional server settings ----
# EVENT_NAME=CODE REDLINE: ROAD TO HEXAWARE   # one event row per name; one WorldRoom per process
# JOIN_RATE_LIMIT=60                          # create/join attempts per IP per minute (venue NAT: keep generous)
# TRUST_PROXY=true                            # set behind Fly/Render/Railway proxies so rate limits see client IPs
# PGLITE_DIR=./.data/pglite                   # dev only, when DATABASE_URL is unset (default: in-memory)
