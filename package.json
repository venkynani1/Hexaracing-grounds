{
  "name": "code-redline",
  "private": true,
  "version": "0.0.0",
  "description": "CODE REDLINE: ROAD TO HEXAWARE — single-world multiplayer racing event",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/loadtest",
    "tools/mapbuild",
    "tools/assets"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c red,cyan \"npm run dev -w @redline/server\" \"npm run dev -w @redline/web\"",
    "test": "vitest run && vitest run --config vitest.perf.config.ts",
    "test:watch": "vitest",
    "test:e2e": "npm run test:e2e -w @redline/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build -w @redline/web",
    "db:generate": "npm run db:generate -w @redline/db --",
    "db:migrate": "npm run db:migrate -w @redline/db",
    "db:verify": "npm run db:verify -w @redline/db",
    "loadtest": "npm run start -w @redline/loadtest --",
    "map:extract": "python3 tools/mapbuild/extract.py tools/mapbuild/data/raw/tamil_nadu.osm.pbf tools/mapbuild/data/raw/chennai-extract.json",
    "map:build": "npm run build -w @redline/mapbuild",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "assets:fetch": "npm run fetch -w @redline/assets",
    "assets:build": "npm run build -w @redline/assets"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "concurrently": "^9.2.1",
    "typescript": "5.9.3",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@neon/config": "^1.14.6",
    "@neon/env": "^2.1.9"
  }
}
