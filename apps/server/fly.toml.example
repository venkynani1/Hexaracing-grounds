# Example Fly.io config (copy to fly.toml and set your own app name/region). One machine, always on:
# the world lives in ONE process — never scale to multiple instances.
app = "code-redline-server"
primary_region = "maa"   # Chennai

[build]
  dockerfile = "apps/server/Dockerfile"

[env]
  PORT = "2567"
  MAP = "chennai"
  TRUST_PROXY = "true"

[http_service]
  internal_port = 2567
  force_https = true
  auto_stop_machines = "off"    # never sleep during an event
  auto_start_machines = true
  min_machines_running = 1
  [http_service.concurrency]
    type = "connections"
    soft_limit = 400
    hard_limit = 600

[[vm]]
  size = "performance-2x"       # dedicated CPU: the 20 Hz tick budget needs it
  memory = "2gb"

[checks]
  [checks.health]
    type = "http"
    port = 2567
    path = "/api/health"
    interval = "10s"
    timeout = "2s"
